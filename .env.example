# Aegis Environment Variables
# Copy to .env and fill in your values

# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────
# Option A: Full connection string (takes priority)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis

# Option B: Individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegis
DB_USER=postgres
DB_PASSWORD=

# Set to true to skip DB and run with in-memory data (no PostgreSQL needed)
SKIP_DB=true

# ── Authentication ─────────────────────────────────────────────────
# Include in requests as: x-api-key: <value>
API_KEY=aegis-dev-key

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Frontend ───────────────────────────────────────────────────────
# API base URL used by the Next.js frontend (no /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── AI / LLM Providers ─────────────────────────────────────────────
# Switch providers anytime by setting LLM_PROVIDER and your API key:
# Supported providers: gemini | groq | openrouter | openai | deepseek | mistral | anthropic | ollama | custom

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=

# ── Or provider-specific keys (auto-detected):
# Google Gemini:
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (Free & Fast Llama 3.3 70B):
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter (Unified router for all models):
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI:
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Ollama (Local & Free):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
