{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "agents/**/*",
    "graph/**/*",
    "models/**/*",
    "tools/**/*",
    "shared/**/*",
    "rag/**/*",
    "memory/**/*",
    "evaluation/**/*",
    "observability/**/*"
  ],
  "exclude": ["node_modules", "dist", "apps"]
}
