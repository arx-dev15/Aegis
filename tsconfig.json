{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "agents/**/*",
    "graph/**/*",
    "models/**/*",
    "tools/**/*",
    "shared/**/*",
    "rag/**/*",
    "memory/**/*",
    "evaluation/**/*",
    "observability/**/*",
    "apps/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
