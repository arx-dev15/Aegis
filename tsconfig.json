{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/agent/**/*",
    "src/runtime/**/*",
    "src/workflows/**/*",
    "src/context/**/*",
    "src/tools/**/*",
    "src/security/**/*",
    "src/verification/**/*",
    "src/shared/**/*",
    "src/intelligence/**/*",
    "apps/cli/**/*",
    "cli.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/api",
    "apps/web"
  ]
}
