{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "models/**/*.ts",
    "agents/**/*.ts",
    "graph/**/*.ts",
    "tools/**/*.ts",
    "rag/**/*.ts",
    "memory/**/*.ts",
    "evaluation/**/*.ts",
    "observability/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "apps"]
}
